# 8th Wall app key. Required — the XR8 engine will not start without it.
#
# Create a project at https://www.8thwall.com/, copy the app key from the
# dashboard, and add every domain you serve from (including Netlify deploy
# previews) to the project's authorised domains. XR8 refuses to run on an
# unlisted origin.
#
# This is a public client identifier restricted by domain, not a secret — which
# is why `?appkey=` also works for a one-off test. It is in .env rather than in
# the repo so that a fork does not silently burn someone else's quota.
VITE_XR8_APP_KEY=

# Nothing else is needed. `?sim=1` runs the whole experience with no key at all,
# using the laptop webcam and a free camera in place of XR8.
